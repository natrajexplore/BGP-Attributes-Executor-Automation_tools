{# ATOMIC_AGGREGATE - EDGE1 summarises the enterprise components into a single
   aggregate with 'summary-only' and WITHOUT 'as-set'. Because AS_PATH detail of
   the contributing routes is lost, BGP sets the ATOMIC_AGGREGATE flag and the
   AGGREGATOR (AS + router-id). #}
{% if rollback %}
router bgp {{ as_enterprise }}
 address-family ipv4
  no aggregate-address {{ enterprise_aggregate_net }} {{ enterprise_aggregate_mask }} summary-only
{% else %}
router bgp {{ as_enterprise }}
 address-family ipv4
  aggregate-address {{ enterprise_aggregate_net }} {{ enterprise_aggregate_mask }} summary-only
{% endif %}
