# Copy to .env and adjust. Consumed by docker-compose.

# --- EVE-NG REST API (reachable from the container via network_mode: host) ---
BGP_EVENG_URL=http://192.168.186.128
BGP_EVENG_USER=admin
BGP_EVENG_PASS=eve
BGP_LAB_PATH=/bgp-attributes.unl

# --- Router credentials (baseline config creates this local user) ---
BGP_DEVICE_USER=lab
BGP_DEVICE_PASS=lab123
BGP_DEVICE_SECRET=lab123

# Fall back to the EVE-NG telnet console port if SSH to the MGMT IP fails
BGP_CONSOLE_FALLBACK=true

# --- Kafka / monitoring (Docker Desktop stack: docker-compose.monitoring.yml) ---
# Windows IP reachable from the EVE VM (Kafka's EXTERNAL advertised listener)
KAFKA_ADVERTISED_HOST=192.168.186.1
# Backend (on EVE VM) -> Kafka on Windows. Leave empty to disable publishing.
BGP_KAFKA_BOOTSTRAP=192.168.186.1:9094
BGP_POLL_INTERVAL=20
# Link shown in the UI header
BGP_GRAFANA_URL=http://192.168.186.1:3000

