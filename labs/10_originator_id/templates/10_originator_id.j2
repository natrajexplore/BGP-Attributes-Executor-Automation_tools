{# ORIGINATOR_ID - C1 originates a fresh prefix. The route reflector stamps ORIGINATOR_ID = C1's router-ID as it reflects the route, so any
   client that hears it back can recognise its own route. #}
{% if rollback %}
router bgp {{ as_enterprise }}
 address-family ipv4
  no network {{ probe_host }} mask 255.255.255.255
no interface Loopback9
{% else %}
interface Loopback9
 description ORIGINATOR_ID probe
 ip address {{ probe_host }} 255.255.255.255
router bgp {{ as_enterprise }}
 address-family ipv4
  network {{ probe_host }} mask 255.255.255.255
{% endif %}
