{# ATOMIC_AGGREGATE - a summary without as-set loses the AS_PATH detail of its components, so BGP marks it ATOMIC_AGGREGATE and
   records who built it (AGGREGATOR). summary-only suppresses the /24 components on this router only. #}
{% if rollback %}
router bgp {{ as_enterprise }}
 address-family ipv4
  no aggregate-address {{ aggregate_net }} {{ aggregate_mask }} summary-only
{% else %}
router bgp {{ as_enterprise }}
 address-family ipv4
  aggregate-address {{ aggregate_net }} {{ aggregate_mask }} summary-only
{% endif %}
